# 复制为 .env 使用；.env 严禁提交（见 .gitignore）。所有凭证仅放占位符示例。

SECRET_KEY=change…-key
JWT_EXPIRE_MINUTES=120
# 刷新令牌有效期（天）：access 过期后经 POST /auth/refresh 轮换续期
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库：默认项目根 data/app.db；切 MySQL 仅改此串
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# CORS 白名单（pydantic-settings 要求 JSON 数组写法）
CORS_ORIGINS=["*"]

# 实时数据来源开关：sim=服务端模拟(一期，默认) | simulator=B2 独立模拟桩遥测 | mqtt=MQTT 桩上报(三期预留)
REALTIME_SOURCE=sim

# ---- 华为云 IoTDA / MQTT 接入预留（三期启用，本期保持 false）----
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_ACCESS_TOKEN=

# ---- 火山引擎方舟 Ark / Doubao / DeepSeek 大模型（AI 助手；密钥与模型必填，否则 /ai/chat、/ai/plate 返回 503）----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 对话模型：填你账号可用的模型名（如 deepseek-v3-250324）或推理接入点 ID（ep-xxx）
ARK_MODEL=
# 车牌识别视觉模型：必须支持图像输入（如 doubao 系列视觉模型）或对应接入点 ID
ARK_VISION_MODEL=
AI_REQUEST_TIMEOUT_SEC=60
