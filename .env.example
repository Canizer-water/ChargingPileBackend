# 复制为 .env 使用；.env 严禁提交（见 .gitignore）。所有凭证仅放占位符示例。

SECRET_KEY=change…-key
JWT_EXPIRE_MINUTES=120

# 数据库：默认项目根 data/app.db；切 MySQL 仅改此串
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# CORS 白名单（pydantic-settings 要求 JSON 数组写法）
CORS_ORIGINS=["*"]

# 实时数据来源开关：sim=服务端模拟(一期，默认) | simulator=B2 独立模拟桩遥测 | mqtt=MQTT 桩上报(三期预留)
REALTIME_SOURCE=sim

# ---- 华为云 IoTDA / MQTT 接入预留（三期启用，本期保持 false）----
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_ACCESS_TOKEN=
