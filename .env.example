# 复制为 .env 使用；.env 严禁提交（见 .gitignore）。所有凭证仅放占位符示例。

SECRET_KEY=change…-key
JWT_EXPIRE_MINUTES=120
# 刷新令牌有效期（天）：access 过期后经 POST /auth/refresh 轮换续期
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库：默认项目根 data/app.db；切 MySQL 仅改此串
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# CORS 白名单（pydantic-settings 要求 JSON 数组写法）
CORS_ORIGINS=["*"]

# 实时数据来源：sim=服务端模拟(默认) | simulator=B2 独立模拟桩 | mqtt=MQTT 订阅上报 | shadow=IoTDA 影子查询(三期)
REALTIME_SOURCE=sim

# ---- 华为云 IoTDA / MQTT（三期；影子回环桥与 MQTT 订阅 consumer 二选一）----
# 影子回环桥：IOTDA_ENABLED=true 时后端本地模拟桩经 MQTT 上报 + 轮询影子刷缓存
IOTDA_ENABLED=false
# MQTT 订阅 consumer（与 shadow 互斥）
MQTT_ENABLED=false
# 设备 MQTT 接入（MQTTS 8883；device1 用 MQTT_*，device2 用 MQTT2_*）
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_ACCESS_TOKEN=
MQTT_CLIENT_ID=
MQTT2_USERNAME=
MQTT2_ACCESS_TOKEN=
MQTT2_CLIENT_ID=
# IoTDA 应用侧（影子查询，AK/SK；密钥只放 .env）
IOTDA_REGION=cn-north-4
IOTDA_AK=
IOTDA_SK=
IOTDA_PROJECT_ID=
IOTDA_ENDPOINT=
IOTDA_SERVICE_ID=
IOTDA_DEVICE1_ID=
IOTDA_DEVICE2_ID=
IOTDA_POLL_SEC=3
IOTDA_REPORT_SEC=3
